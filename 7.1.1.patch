+
+      const mover = column[start];
+      let canMoveSomewhere = false;
+
+      for (let to = 0; to < targetTops.length; to++) {
+        if (from === to) continue;
+        if (isValidMove(mover, targetTops[to])) {
+          canMoveSomewhere = true;
+          break;
+        }
+      }
+
+      if (canMoveSomewhere) {
+        sources.push({ deckIndex: from, cardIndex: start });
+      }
+    }
+  }
+
+  return sources;
+};
